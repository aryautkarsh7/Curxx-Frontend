# Curxx website settings. Every variable the code reads. Copy to .env.local for local work.
# Values without quotes. Production values live in Vercel > curxx-frontend > Settings > Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time.

# Base URL of the Curxx API (backend/).
# Production (scope: Production only): https://crux-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical site origin, used for canonical tags, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://curxx-frontend.vercel.app

# Search-engine switch: only production lets the site be indexed. Unset = Vercel's VERCEL_ENV decides.
# Production: staging until launch day, then production.
APP_ENV=staging

# Optional server-side override of the canonical origin (wins over NEXT_PUBLIC_SITE_URL).
SITE_URL=

# Set by Vercel automatically; do not add there: VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV
