# Curxx website: copy to .env and fill values. Values without quotes. Never commit .env.
# Production values live in Vercel > curxx-frontend > Settings > Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time.

# Base URL of the Curxx API (backend/). Production: https://crux-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical site origin for canonical tags, sitemap and Open Graph. Production: https://curxx-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search-engine switch: only "production" lets the site be indexed. Production: staging until launch day.
APP_ENV=development
# Optional server-side override of the canonical origin (wins over NEXT_PUBLIC_SITE_URL).
SITE_URL=
